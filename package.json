{
  "name": "anirudh-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
